# Defaults for img-build/*.sh. Override on the command line or export before running.
# shellcheck disable=SC2034

ARMBIAN_REPO="${ARMBIAN_REPO:-https://github.com/OpenNeptune3D/Armbian-ZNP-K1-build.git}"
ARMBIAN_BRANCH="${ARMBIAN_BRANCH:-main}"
ARMBIAN_DIR="${ARMBIAN_DIR:-${HOME}/src/Armbian-ZNP-K1-build}"

# Match v0.1.7: Armbian 25.11, Trixie, edge kernel. Adjust when the base moves.
BOARD="${BOARD:-znp-k1}"
BRANCH="${BRANCH:-edge}"
RELEASE="${RELEASE:-trixie}"
VENDOR="${VENDOR:-OpenNept4une}"

# Size: v0.1.7 uncompressed is 7456 MiB and misses some 8 GB chips (~7.2 GiB).
# Keep the published .img at or under this cap. First boot resizes to the device.
MAX_IMAGE_MIB="${MAX_IMAGE_MIB:-7000}"
SLACK_MIB="${SLACK_MIB:-384}"

# Slimmer than the README compile line: headers and a full CLI userspace
# are the easy wins. EXTRAWIFI stays on for USB adapters.
BUILD_MINIMAL="${BUILD_MINIMAL:-no}"
BUILD_DESKTOP="${BUILD_DESKTOP:-no}"
KERNEL_CONFIGURE="${KERNEL_CONFIGURE:-no}"
EXTRAWIFI="${EXTRAWIFI:-yes}"
INSTALL_HEADERS="${INSTALL_HEADERS:-no}"
BSPFREEZE="${BSPFREEZE:-yes}"
COMPRESS_OUTPUTIMAGE="${COMPRESS_OUTPUTIMAGE:-xz}"
FIXED_IMAGE_SIZE="${FIXED_IMAGE_SIZE:-}"

TARGET_USER="${TARGET_USER:-mks}"
TARGET_PASSWORD="${TARGET_PASSWORD:-makerbase}"

KLIPPER_REPO="${KLIPPER_REPO:-https://github.com/Klipper3d/klipper.git}"
MOONRAKER_REPO="${MOONRAKER_REPO:-https://github.com/Arksine/moonraker.git}"
KAMP_REPO="${KAMP_REPO:-https://github.com/kyleisah/Klipper-Adaptive-Meshing-Purging.git}"
KIAUH_REPO="${KIAUH_REPO:-https://github.com/dw-0/kiauh.git}"
DISPLAY_CONNECTOR_REPO="${DISPLAY_CONNECTOR_REPO:-https://github.com/OpenNeptune3D/display_connector.git}"
MOBILERAKER_REPO="${MOBILERAKER_REPO:-https://github.com/Clon1998/mobileraker_companion.git}"
FLUIDD_ZIP="${FLUIDD_ZIP:-https://github.com/fluidd-core/fluidd/releases/latest/download/fluidd.zip}"
MAINSAIL_ZIP="${MAINSAIL_ZIP:-https://github.com/mainsail-crew/mainsail/releases/latest/download/mainsail.zip}"

INSTALL_FLUIDD="${INSTALL_FLUIDD:-1}"
INSTALL_MAINSAIL="${INSTALL_MAINSAIL:-1}"
INSTALL_DISPLAY="${INSTALL_DISPLAY:-1}"
INSTALL_MOBILERAKER="${INSTALL_MOBILERAKER:-1}"
INSTALL_VIRTUAL_MCU="${INSTALL_VIRTUAL_MCU:-1}"

WORK_DIR="${WORK_DIR:-${HOME}/opennept4une-img-build}"
XZ_ARGS="${XZ_ARGS:--T0 -9}"
